# Copy to .env and fill in real values.
# docker-compose reads this automatically — do not commit .env.

# MariaDB
MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=autoCowboy
MYSQL_PASSWORD=changeme

# Host paths for persistent data volumes
# Windows/WSL example: /mnt/c/Users/you/Desktop/securityCowboy/mariadb_data
# Linux example:       /opt/securitycowboy/mariadb_data
MARIADB_DATA_PATH=/path/to/mariadb_data

# MinIO
MINIO_ROOT_USER=adminCowboy
MINIO_ROOT_PASSWORD=changeme
MINIO_DATA_PATH=/path/to/minio_data

# RabbitMQ
RABBITMQ_DEFAULT_USER=cowboyRabbit
RABBITMQ_DEFAULT_PASS=changeme

# ── Bot (OpenClaw) ────────────────────────────────────────────────────────────
# OpenClaw platform auth token — run `openclaw auth token` on the host to get this
OPENCLAW_AUTH_TOKEN=

# Discord bot token — discord.com/developers → your application → Bot → Token
DISCORD_BOT_TOKEN=

# Discord channel ID for pipeline log streaming — right-click channel → Copy Channel ID
DISCORD_LOG_CHANNEL_ID=

# Gemini API key (optional — used as LLM fallback if Ollama is unavailable)
GEMINI_API_KEY=
