# Copy to .env and fill in real values.
# docker-compose reads this automatically — do not commit .env.

# MariaDB
MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=autoCowboy
MYSQL_PASSWORD=changeme

# Host paths for persistent data volumes
# Windows/WSL example: /mnt/c/Users/you/Desktop/clipCowboy/mariadb_data
# Linux example:       /opt/clipcowboy/mariadb_data
MARIADB_DATA_PATH=/path/to/mariadb_data

# MinIO
MINIO_ROOT_USER=adminCowboy
MINIO_ROOT_PASSWORD=changeme
MINIO_DATA_PATH=/path/to/minio_data

# RabbitMQ
RABBITMQ_DEFAULT_USER=cowboyRabbit
RABBITMQ_DEFAULT_PASS=changeme

# ── Bot (OpenClaw) ────────────────────────────────────────────────────────────
# OpenClaw platform auth token — run `openclaw auth token` on the host to get this
OPENCLAW_AUTH_TOKEN=

# Discord bot token — discord.com/developers → your application → Bot → Token
DISCORD_BOT_TOKEN=

# Discord channel ID for pipeline log streaming — right-click channel → Copy Channel ID
DISCORD_LOG_CHANNEL_ID=

# Gemini API key (optional — used as LLM fallback if Ollama is unavailable)
GEMINI_API_KEY=

# Ollama (local LLM)
# Host resolves via AdGuard local DNS (ollama.truck → Sparky).
# OpenClaw demands a non-empty API key even for local Ollama; any value works.
# Ollama (local LLM)
# Host resolves via AdGuard local DNS (ollama.truck → Sparky).
# OpenClaw demands a non-empty API key even for local Ollama; any value works.
OLLAMA_HOST=http://ollama.truck:11434
OLLAMA_API_KEY=ollama-local

# Discord scoping for the OpenClaw bot.
# Right-click a server → Copy Server ID; right-click a channel → Copy Channel ID.
# Used by scripts/bot-config.sh to lock the bot to one guild + one channel.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Pipeline control server URL — host IP reachable from Docker (e.g. http://192.168.1.x:8765)
# Run `ip route | grep default` to find host IP visible from containers
PIPELINE_CONTROL_URL=http://192.168.1.x:8765
