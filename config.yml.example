# Copy this file to config.yml and fill in your values.
# config.yml is gitignored — never commit the real config.

storage:
  endpoint_url: http://localhost:9000
  access_key: adminCowboy
  secret_key: changeme
  region_name: us-east-1
  buckets:
    input: security-camera-unprocessed
    converted: security-camera-converted
    output: security-camera-processed
    quarantine: security-camera-quarantine

database:
  host: localhost
  port: 3306
  name: footage_metadata
  user: autoCowboy
  password: changeme

rabbitmq:
  host: localhost
  port: 5672
  user: cowboyRabbit
  password: changeme

model:
  path: models/yolov8n.pt
  confidence: 0.25
  debug: false
  debug_dir: debug

watcher:
  scan_interval: 60   # seconds between MinIO scans

filters:
  F:
    spatial_mask:
      vertices: [[0, 0], [640, 0], [640, 408], [0, 408]]
  B:
    spatial_mask:
      vertices: [[0, 0], [640, 0], [640, 480], [0, 480]]
  L:
    spatial_mask:
      vertices: [[0, 0], [480, 0], [480, 480], [0, 480]]
  R:
    spatial_mask:
      vertices: [[160, 0], [640, 0], [640, 480], [160, 480]]
